{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["react", "typescript", "unicorn"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"ignorePatterns": ["dist", "node_modules", "playground/dist"],
	"rules": {
		"react/react-in-jsx-scope": "off"
	}
}
