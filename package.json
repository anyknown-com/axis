{
	"name": "@anyknown/axis",
	"version": "0.1.0",
	"description": "Headless scroll primitive for x, y and 2D panning: native scroll first, mouse drag as an enhancement",
	"keywords": [
		"carousel",
		"drag-scroll",
		"headless",
		"kanban",
		"pan",
		"react",
		"scroll",
		"scroll-snap"
	],
	"bugs": {
		"url": "https://github.com/anyknown-com/axis/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anyknown-com/axis.git"
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./dist/index.d.ts",
	"typesVersions": {
		"*": {
			"react": [
				"./dist/react.d.ts"
			]
		}
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"default": "./dist/react.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/esm-extensions.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint src test playground",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"check": "pnpm typecheck && pnpm lint && pnpm fmt:check",
		"test": "vitest run",
		"dev": "vite --config playground/vite.config.ts",
		"prepublishOnly": "pnpm check && pnpm test && pnpm build"
	},
	"devDependencies": {
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.5",
		"@vitest/browser-playwright": "^4.1.11",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"playwright": "^1.55.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"typescript": "^5.9.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"packageManager": "pnpm@10.30.3"
}
